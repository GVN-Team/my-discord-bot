import os
from paypaython import PayPay

# 設定情報
PHONE = "08012345678"  # PayPay登録電話番号
PASSWORD = "YourPayPayPassword"  # PayPayパスワード
TOKEN_FILE = "paypay_token.txt"  # トークン保存先ファイル名


def get_paypay_client() -> PayPay:
  """トークンが存在すればトークンで初期化し、なければパスワードでログインしてトークンを保存する関数

  """
  # 1. 保存されたトークンがあるかチェック
  if os.path.exists(TOKEN_FILE):
    with open(TOKEN_FILE, "r", encoding="utf-8") as f:
      token = f.read().strip()
    if token:
      # トークンを使って初期化
      return PayPay(access_token=token)

  # 2. トークンがない（または空の）場合は電話番号とパスワードでログイン
  return relogin_and_save()


def relogin_and_save() -> PayPay:
  """電話番号とパスワードで新規ログインし、最新トークンをファイルに上書き保存する関数

  """
  print("PayPayに再ログイン中...")
  # 電話番号とパスワードで初期化
  client = PayPay(phone=PHONE, password=PASSWORD)

  # ログイン後に発行された新しいトークンを取得して保存
  new_token = client.access_token
  with open(TOKEN_FILE, "w", encoding="utf-8") as f:
    f.write(new_token)

  print("新しいアクセストークンを保存しました。")
  return client
